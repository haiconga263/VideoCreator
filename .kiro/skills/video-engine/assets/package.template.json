{
  "name": "kiro-tutorial-video",
  "version": "1.0.0",
  "description": "Tạo video hướng dẫn từ slide HTML/CSS (render frame + ghép bằng FFmpeg), hỗ trợ preset YouTube 16:9 và TikTok 9:16.",
  "main": "render.js",
  "scripts": {
    "music": "node make-music.js",
    "render": "node render.js",
    "youtube": "node render.js --preset youtube",
    "tiktok": "node render.js --preset tiktok",
    "all": "node render.js --preset all",
    "frames": "node render.js --preset all --frames-only",
    "video": "node render.js --preset all --video-only",
    "preview": "node preview.js"
  },
  "keywords": ["video", "html", "css", "puppeteer", "ffmpeg", "tutorial"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "puppeteer": "^25.12.0"
  }
}
